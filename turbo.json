{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "build/**",
        ".svelte-kit/**",
        "dist/**"
      ],
      "env": [
        "PUBLIC_*",
        "NODE_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "clean": {
      "cache": false
    },
    "test": {}
  }
}
