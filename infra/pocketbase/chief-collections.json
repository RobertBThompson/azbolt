[
	{
		"name": "workspaces",
		"type": "base",
		"listRule": "owner = @request.auth.id",
		"viewRule": "owner = @request.auth.id",
		"createRule": "@request.auth.id != '' && owner = @request.auth.id",
		"updateRule": "owner = @request.auth.id",
		"deleteRule": "owner = @request.auth.id",
		"fields": [
			{ "name": "name", "type": "text", "required": true, "presentable": true, "max": 120 },
			{
				"name": "kind",
				"type": "select",
				"required": true,
				"maxSelect": 1,
				"values": ["company", "holding", "nonprofit", "dao", "personal"]
			},
			{ "name": "blurb", "type": "text", "max": 240 },
			{
				"name": "swatch",
				"type": "select",
				"required": true,
				"maxSelect": 1,
				"values": ["solid", "hatched", "split"]
			},
			{ "name": "hue", "type": "text", "max": 32 },
			{
				"name": "owner",
				"type": "relation",
				"required": true,
				"maxSelect": 1,
				"cascadeDelete": true,
				"collectionId": "_pb_users_auth_"
			}
		],
		"indexes": ["CREATE UNIQUE INDEX idx_workspaces_owner_name ON workspaces (owner, name)"]
	},
	{
		"name": "people",
		"type": "base",
		"listRule": "owner = @request.auth.id",
		"viewRule": "owner = @request.auth.id",
		"createRule": "@request.auth.id != '' && owner = @request.auth.id",
		"updateRule": "owner = @request.auth.id",
		"deleteRule": "owner = @request.auth.id",
		"fields": [
			{ "name": "first_name", "type": "text", "required": true, "presentable": true, "max": 80 },
			{ "name": "last_name", "type": "text", "max": 80 },
			{ "name": "role", "type": "text", "max": 120 },
			{ "name": "relationship", "type": "text", "max": 80 },
			{ "name": "is_me", "type": "bool" },
			{
				"name": "workspace",
				"type": "relation",
				"required": false,
				"maxSelect": 1,
				"cascadeDelete": false,
				"collectionId": "workspaces"
			},
			{ "name": "next_interaction", "type": "date" },
			{ "name": "notes", "type": "text", "max": 2000 },
			{
				"name": "owner",
				"type": "relation",
				"required": true,
				"maxSelect": 1,
				"cascadeDelete": true,
				"collectionId": "_pb_users_auth_"
			}
		],
		"indexes": [
			"CREATE INDEX idx_people_owner ON people (owner)",
			"CREATE INDEX idx_people_workspace ON people (workspace)"
		]
	}
]
