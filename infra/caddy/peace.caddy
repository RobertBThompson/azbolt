# Generated by generate.sh — do not edit the per-app .caddy files by hand.
# Edit this template, or the host in generate.sh, and re-run it.
# Deployed to /etc/caddy/azbolt/<app>.caddy

peace.155.138.240.74.nip.io {
	encode zstd gzip

	# Everything not claimed above is the static build. handle blocks are
	# mutually exclusive and run in written order, which is what keeps
	# try_files from rewriting a proxied path before the proxy sees it.
	handle {
		root * /var/www/azbolt/peace

		# Precompressed .br/.gz emitted by the SvelteKit build
		file_server {
			precompressed br gzip
		}

		# Immutable hashed build assets
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Never cache the service worker or the manifest
		@no-cache path /sw.js /registerSW.js /manifest.webmanifest
		header @no-cache Cache-Control "no-cache, no-store, must-revalidate"

		# SPA fallback for client-side routes
		try_files {path} {path}.html {path}/index.html /200.html
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	log {
		output file /var/log/caddy/azbolt-peace.log
	}
}
