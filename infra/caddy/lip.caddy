# LIP runs as a Node server (adapter-node) under systemd on 127.0.0.1:3003.
lip.155.138.240.74.nip.io {
	encode zstd gzip

	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@no-cache path /sw.js /registerSW.js /manifest.webmanifest
	header @no-cache Cache-Control "no-cache, no-store, must-revalidate"

	# Caddy passes X-Forwarded-Proto / -Host / -For upstream by default,
	# so setting them explicitly is redundant and Caddy warns about it.
	reverse_proxy 127.0.0.1:3003

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	log {
		output file /var/log/caddy/azbolt-lip.log
	}
}
