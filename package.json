{
	"name": "azbolt",
	"private": true,
	"version": "0.1.0",
	"description": "AZBOLT monorepo \u2014 SvelteKit PWAs (chief, chaim, lip, peace, tithe)",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "turbo run dev",
		"dev:host": "turbo run dev -- --host",
		"build": "turbo run build",
		"preview": "turbo run preview",
		"check": "turbo run check",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{js,ts,svelte,json,css,md}\"",
		"clean": "turbo run clean && rm -rf node_modules",
		"test": "turbo run test"
	},
	"devDependencies": {
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.6",
		"turbo": "^2.1.3"
	}
}
